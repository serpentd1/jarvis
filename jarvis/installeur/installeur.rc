1 ICON "../lanceur/jarvis.ico"
1 24 "installeur.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "Jarvis"
      VALUE "FileDescription", "Installer Jarvis"
      VALUE "FileVersion", "1.0.0"
      VALUE "OriginalFilename", "Installer-Jarvis.exe"
      VALUE "ProductName", "Jarvis"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
