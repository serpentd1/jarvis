1 ICON "jarvis.ico"

1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "Jarvis"
      VALUE "FileDescription", "Jarvis - ile, widgets et icone"
      VALUE "FileVersion", "1.1.0"
      VALUE "InternalName", "JarvisBarre"
      VALUE "OriginalFilename", "JarvisBarre.exe"
      VALUE "ProductName", "Jarvis"
      VALUE "ProductVersion", "1.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
