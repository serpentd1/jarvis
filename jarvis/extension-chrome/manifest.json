{
  "manifest_version": 3,
  "name": "Jarvis — pont Chrome",
  "version": "1.0.0",
  "description": "Relie Chrome à l'assistant vocal Jarvis (sur ton PC) : vidéos (pause, vitesse, avancer…) et messages privés Discord.",
  "permissions": ["tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://discord.com/*"], "js": ["discord-page.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://discord.com/*"], "js": ["discord.js"], "run_at": "document_idle" },
    { "matches": ["<all_urls>"], "js": ["video.js"], "run_at": "document_idle" }
  ],
  "icons": { "16": "icone-16.png", "48": "icone-48.png", "128": "icone-128.png" },
  "action": { "default_title": "Jarvis", "default_icon": { "16": "icone-16.png", "48": "icone-48.png" } }
}
